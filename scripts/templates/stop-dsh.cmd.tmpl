@echo off
rem Generated by dsh-auto-update  (scripts/install-desktop.mjs).
rem Stops DSH by finding the PID listening on the port and killing its process tree.
rem Sends no console event, so child processes (MCP servers) print nothing.
title Stop DSH
powershell -NoProfile -Command "$l = netstat -ano -p TCP ^| Select-String ':__PORT__\b.*LISTENING'; if (-not $l) { Write-Host 'DSH is not listening on port __PORT__ - nothing to stop.'; exit 1 }; $l ^| ForEach-Object { $p = ($_.Line -split '\s+')[-1]; Write-Host ('Stopping DSH (PID ' + $p + ') ...'); & taskkill /PID $p /T /F ^| Out-Null }"
echo Done.
pause
